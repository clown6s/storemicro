# ===========================================
# Storemicro Gateway 环境变量配置模板
# 复制此文件为 .env 并填入实际值:  cp .env.example .env
# ===========================================

# JWT 签名密钥（必须 >= 32 字符，生产环境务必使用强随机密钥）
JWT_SECRET=your-jwt-secret-key-at-least-32-chars

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# etcd 服务发现
ETCD_ENDPOINT=127.0.0.1:2379

# OpenTelemetry 链路追踪 (OTLP gRPC)
TRACING_ENDPOINT=127.0.0.1:4317

# Prometheus Metrics 认证密码（为空则禁用 metrics 端点）
METRICS_PASSWORD=
